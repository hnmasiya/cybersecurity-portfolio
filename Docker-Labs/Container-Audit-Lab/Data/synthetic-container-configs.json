[
  {
    "name": "legacy-web-app",
    "image": "myapp:latest",
    "user": "root",
    "env": {
      "APP_ENV": "production",
      "API_KEY": "sk-live-9f8a7b6c5d4e3f2a1b0c"
    },
    "privileged": true,
    "network_mode": "bridge",
    "volumes": ["/var/run/docker.sock:/var/run/docker.sock", "/data:/data"]
  },
  {
    "name": "legacy-monitoring-agent",
