  },
  {
    "name": "hardened-api",
    "image": "myapp-api:2.4.1",
    "user": "appuser",
    "env": {
      "APP_ENV": "production",
      "API_KEY": "changeme"
    },
    "privileged": false,
    "network_mode": "bridge",
    "volumes": ["/data:/data:ro"]
