{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ScopedDeploymentAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "codedeploy:*"
      ],
      "Resource": [
        "arn:aws:s3:::corp-deployment-bucket/*",
        "arn:aws:codedeploy:*:*:application/MicroservicesApp"
      ]
    }
  ]
}
