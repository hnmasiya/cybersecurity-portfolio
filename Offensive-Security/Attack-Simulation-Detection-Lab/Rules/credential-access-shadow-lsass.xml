<!--
  Attack Simulation & Detection Engineering Lab - T1003 (Credential Access)
  Catches an access attempt on /etc/shadow on Linux (via an auditd file
  watch) and a memory-access attempt against lsass.exe on Windows (via
  Sysmon Event ID 10), as two rules in the same group.

  As with the other rules in this lab, verify the exact parent
  <if_group>/field names against the live manager's actual decoded
  events the first time this is tested - these follow Wazuh's
  documented auditd/Sysmon integration conventions but haven't been
  confirmed against this specific deployment yet.
-->
<group name="attack_sim,credential_access,t1003,">

  <!-- Linux: read attempt on /etc/shadow -->
  <rule id="100220" level="13">
    <if_group>audit_watch_key</if_group>
    <field name="audit.key">shadow_access</field>
    <description>Credential Access: read attempt on /etc/shadow</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
  </rule>

  <!-- Windows: process access targeting lsass.exe -->
  <rule id="100221" level="13">
    <if_group>sysmon_event10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <description>Credential Access: process memory access targeting lsass.exe</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

</group>
