<!--
  Attack Simulation & Detection Engineering Lab - T1003 (Credential Access)
  Catches an access attempt on /etc/shadow on Linux (via an auditd file
  watch) and a memory-access attempt against lsass.exe on Windows (via
  Sysmon Event ID 10), as two rules in the same group.

  The Linux rule was verified live via wazuh-logtest against a real
  captured audit.log line for `cat /etc/shadow` as a non-root user.
  Unlike the EXECVE-type records the execution rule deals with, this
  SYSCALL-type record decodes cleanly into named fields (audit.key,
  audit.success, audit.command, etc.) - no full_log/<match> workaround
  needed here. The same live test also caught a real false positive
  source: sudo itself reads /etc/shadow internally on every
  authentication (PAM's pam_unix module checking the password hash),
  which trips the same auditd watch key with audit.success=yes and
  audit.command=sudo. Requiring audit.success=no excludes that
  legitimate case while still catching the actual unprivileged read
  attempt, which is semantically the right filter anyway - the
  attempt being denied is the T1003.008 signal, not whether it
  succeeded.
-->
<group name="attack_sim,credential_access,t1003,">

  <!-- Linux: denied read attempt on /etc/shadow (audit.success=no
       excludes sudo's own internal shadow read during authentication,
       confirmed as a real false-positive source via live testing) -->
  <rule id="100220" level="13">
    <if_sid>80700</if_sid>
    <field name="audit.key">shadow_access</field>
    <field name="audit.success">no</field>
    <description>Credential Access: unprivileged read attempt on /etc/shadow (denied)</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
  </rule>

  <!-- Windows: process access targeting lsass.exe (group name confirmed
       against Wazuh's own upstream ruleset - events 10+ use an
       underscore, sysmon_event_10, unlike events 1-9 which don't; the
       no-underscore guess was silently ignored, confirmed via the
       manager log warning `Group 'sysmon_event10' was not found.
       Invalid 'if_group'. Rule '100221' will be ignored.`) -->
  <rule id="100221" level="13">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <description>Credential Access: process memory access targeting lsass.exe</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

</group>
