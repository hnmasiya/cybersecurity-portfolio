# Copy this file to .env in the same directory and fill in real values.
# .env is gitignored at the repo root — never commit it.

# Check https://github.com/OpenCTI-Platform/docker/releases for the current
# stable release tag before deploying — this pins the platform, worker, and
# connector images to the same version, which OpenCTI requires.
OPENCTI_VERSION=6.5.7

# Reachable from your browser once the stack is up, e.g. http://<host-ip>:8080
OPENCTI_BASE_URL=http://localhost:8080

OPENCTI_ADMIN_EMAIL=admin@REPLACE-WITH-YOUR-DOMAIN.local
OPENCTI_ADMIN_PASSWORD=REPLACE-WITH-A-STRONG-PASSWORD

# Both must be valid UUIDv4 strings. Generate with: uuidgen  (or: python3 -c "import uuid; print(uuid.uuid4())")
OPENCTI_ADMIN_TOKEN=REPLACE-WITH-A-GENERATED-UUID4
CONNECTOR_MITRE_ID=REPLACE-WITH-A-DIFFERENT-GENERATED-UUID4

MINIO_ROOT_USER=REPLACE-WITH-A-USERNAME
MINIO_ROOT_PASSWORD=REPLACE-WITH-A-STRONG-PASSWORD

RABBITMQ_DEFAULT_USER=REPLACE-WITH-A-USERNAME
RABBITMQ_DEFAULT_PASS=REPLACE-WITH-A-STRONG-PASSWORD

# Elasticsearch JVM heap. Keep well under the host's total RAM alongside
# everything else in this stack — see README.md for sizing guidance.
ELASTIC_MEMORY_SIZE=2g
