# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

admin_username  = "labadmin"
admin_password  = "REPLACE-WITH-A-STRONG-PASSWORD"   # 12+ chars, upper/lower/number/symbol
admin_source_ip = "REPLACE-WITH-YOUR-PUBLIC-IP/32"    # e.g. "203.0.113.10/32" — find yours at https://ifconfig.me

# Optional overrides (defaults live in variables.tf)
# resource_group_name = "rg-winserver-security-lab"
# location             = "eastus"
# vm_name              = "dc01-lab"
# vm_size              = "Standard_B2s"
